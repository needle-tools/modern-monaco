{
  "name": "@needle-tools/modern-monaco",
  "description": "A modern version of Monaco Editor",
  "version": "0.3.8-needle.1",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./types/index.d.ts"
    },
    "./core": {
      "import": "./dist/core.mjs",
      "types": "./types/core.d.ts"
    },
    "./workspace": {
      "import": "./dist/workspace.mjs",
      "types": "./types/workspace.d.ts"
    },
    "./ssr": {
      "workerd": "./dist/ssr/workerd.mjs",
      "import": "./dist/ssr/index.mjs",
      "types": "./types/ssr.d.ts"
    },
    "./editor-core": {
      "import": "./dist/editor-core.mjs",
      "types": "./types/monaco.d.ts"
    },
    "./editor-worker": {
      "import": "./dist/editor-worker.mjs"
    },
    "./editor-worker-main": {
      "import": "./dist/editor-worker-main.mjs"
    },
    "./cache": {
      "import": "./dist/cache.mjs"
    },
    "./shiki": {
      "import": "./dist/shiki.mjs"
    },
    "./util": {
      "import": "./dist/util.mjs"
    },
    "./lsp": {
      "import": "./dist/lsp/index.mjs"
    },
    "./lsp/*": {
      "import": "./dist/lsp/*.mjs"
    },
    "./lsp/typescript/setup": {
      "types": "./types/typescript-setup.d.ts",
      "import": "./dist/lsp/typescript/setup.mjs"
    }
  },
  "esm.sh": {
    "bundle": false
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "prepublishOnly": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "update-language-configurations": "bun scripts/update-language-configurations.ts",
    "dev": "bun scripts/dev.ts",
    "fmt": "dprint fmt",
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "files": [
    "dist/",
    "types/",
    "NEEDLE.md"
  ],
  "browser": {
    "process": false,
    "buffer": false
  },
  "sideEffects": [
    "dist/index.mjs"
  ],
  "devDependencies": {
    "@esm.sh/import-map": "0.1.1",
    "@shikijs/core": "3.22.0",
    "@shikijs/engine-oniguruma": "3.22.0",
    "esbuild": "0.27.3",
    "monaco-editor-core": "0.55.1",
    "tm-grammars": "1.30.8",
    "tm-themes": "1.11.1",
    "typescript": "5.9.3",
    "vscode-css-languageservice": "6.3.9",
    "vscode-html-languageservice": "5.6.1",
    "vscode-json-languageservice": "5.7.1",
    "vscode-languageserver-textdocument": "1.0.12",
    "vscode-languageserver-types": "3.17.5"
  },
  "peerDependencies": {
    "typescript": ">= 5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/needle-tools/modern-monaco.git"
  },
  "license": "MIT"
}
